# Copy to .env.local and fill in. Never commit real values.

# "api" (default): use the local FastAPI pipeline at PIPELINE_API_URL.
# "github": create the job in Supabase and run the "Generate site articles" GitHub workflow.
PIPELINE_MODE=api
PIPELINE_API_URL=http://127.0.0.1:8000

# --- Needed only when PIPELINE_MODE=github ---
# Server-side Supabase access (the website reads job progress and articles from here).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Fine-grained personal access token with "Actions: Read and write" on the repository below.
GITHUB_DISPATCH_TOKEN=
# owner/repository that contains .github/workflows/generate-site.yml
GITHUB_REPOSITORY=
GITHUB_WORKFLOW_FILE=generate-site.yml
GITHUB_WORKFLOW_REF=main
